{
  "name": "cc-accounts",
  "version": "0.1.6",
  "description": "Run multiple Claude Code logins side by side. Like ccmirror, but for different claude accounts — claude-work, claude-personal, claude-team, with correct per-account billing isolation.",
  "license": "MIT",
  "author": "Tien Le",
  "type": "module",
  "bin": {
    "cca": "dist/cli.js",
    "cc-accounts": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/PARITY-AUDIT.md"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "cli",
    "accounts",
    "multi-account",
    "switcher",
    "mirror"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nhocconan/cc-accounts.git"
  },
  "homepage": "https://github.com/nhocconan/cc-accounts#readme",
  "bugs": {
    "url": "https://github.com/nhocconan/cc-accounts/issues"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "audit:claude-env": "node scripts/audit/claude-env.mjs --self-test",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "tsup",
    "prepublishOnly": "npm run verify",
    "release": "bash scripts/release.sh",
    "release:dry": "DRY=1 bash scripts/release.sh",
    "verify": "npm run audit:claude-env && npm run typecheck && npm test && npm run build && node dist/cli.js --version",
    "version": "npm run verify && npm pack --dry-run"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "proper-lockfile": "^4.1.2"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "vite": "6.4.3"
  }
}
